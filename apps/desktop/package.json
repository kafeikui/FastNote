{
  "name": "@fastnote/desktop",
  "version": "0.4.0",
  "private": true,
  "description": "FastNote desktop client - encrypted notes + E2E messaging",
  "author": "kafeikui",
  "repository": {
    "type": "git",
    "url": "https://github.com/kafeikui/FastNote.git"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.electron.json && vite build",
    "typecheck": "tsc --noEmit",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "@fastnote/api": "workspace:*",
    "@fastnote/app": "workspace:*",
    "@fastnote/crypto": "workspace:*",
    "@fastnote/shared": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^36.9.5",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.6",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.fastnote.app",
    "productName": "FastNote",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "publish": null,
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "maintainer": "FastNote <fastnote@localhost>",
      "executableName": "fastnote"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ]
  }
}
